# Copy to .env.local and fill in. Never commit real values.

# neatlogs — https://app.neatlogs.com, Settings, API keys
# Project API key: the SDK (Whittle's own agent) and the MCP server.
NEATLOGS_API_KEY=
# HTTP ingest key (starts with nlw_) and the project's name: the proxy publishes
# one trace per sandboxed run through HTTP trace injection with these.
NEATLOGS_WRITE_KEY=
NEATLOGS_PROJECT=
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com
NEATLOGS_WORKFLOW_NAME=my-agent

# The model Whittle's own agent uses. Each developer picks their own.
# WHITTLE_PROVIDER is "anthropic" or "openai" (any OpenAI-compatible API, such as Groq).
WHITTLE_PROVIDER=anthropic
WHITTLE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# For an OpenAI-compatible provider:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# cfo.ai — https://cfo.ai/neathacks (team lead signup; OAuth via MCP, no static API key)
# Connect https://api.cfo.ai/mcp in Cursor/Claude Code and authenticate in the browser.

# neatlogs Public API (S1/S5) — service account from org admin; not the ingest key
# NEATLOGS_TOKEN=
# NEATLOGS_PROJECT_ID=
# NEATLOGS_S5_TRACE_ID=   # optional: trace id for evaluator spike

# Recording proxy (step 1): uv run uvicorn costcutter.proxy.app:app --port 8790
# WHITTLE_PROXY_URL=http://127.0.0.1:8790
# WHITTLE_PROXY_SPEND_CAP_USD=5.0
# WHITTLE_ANTHROPIC_UPSTREAM=https://api.anthropic.com
# WHITTLE_OPENAI_UPSTREAM=https://api.groq.com/openai/v1

# Optional partner credits
# CRUSTDATA_API_KEY=
# AWS_REGION=
