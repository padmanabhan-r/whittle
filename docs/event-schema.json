{
  "$defs": {
    "AgentStepEvent": {
      "additionalProperties": false,
      "description": "One step of our own agent: a thought, a tool call or a tool result.",
      "properties": {
        "seq": {
          "description": "Starts at 1 and rises by 1 per job; also the SSE id",
          "title": "Seq",
          "type": "integer"
        },
        "ts": {
          "title": "Ts",
          "type": "string"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "type": {
          "const": "agent.step",
          "default": "agent.step",
          "title": "Type",
          "type": "string"
        },
        "step_index": {
          "title": "Step Index",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "thought",
            "tool_call",
            "tool_result"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        },
        "finding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finding Id"
        }
      },
      "required": [
        "seq",
        "ts",
        "job_id",
        "step_index",
        "kind",
        "text"
      ],
      "title": "AgentStepEvent",
      "type": "object"
    },
    "CodeLocation": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line_start": {
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "title": "Line End",
          "type": "integer"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        }
      },
      "required": [
        "file",
        "line_start",
        "line_end"
      ],
      "title": "CodeLocation",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        },
        "span_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "trace_url": {
          "title": "Trace Url",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "trace_url",
        "note"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FindingKind"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "estimated_saving_usd_per_run": {
          "title": "Estimated Saving Usd Per Run",
          "type": "number"
        },
        "estimated_saving_pct": {
          "description": "Share of baseline cost per run, 0 to 100",
          "title": "Estimated Saving Pct",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/FindingStatus",
          "default": "proposed"
        },
        "status_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status Reason"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "summary",
        "severity",
        "estimated_saving_usd_per_run",
        "estimated_saving_pct",
        "evidence"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingEvent": {
      "additionalProperties": false,
      "description": "Sent when a finding is first reported and again whenever its status changes.",
      "properties": {
        "seq": {
          "description": "Starts at 1 and rises by 1 per job; also the SSE id",
          "title": "Seq",
          "type": "integer"
        },
        "ts": {
          "title": "Ts",
          "type": "string"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "type": {
          "const": "finding",
          "default": "finding",
          "title": "Type",
          "type": "string"
        },
        "finding": {
          "$ref": "#/$defs/Finding"
        }
      },
      "required": [
        "seq",
        "ts",
        "job_id",
        "finding"
      ],
      "title": "FindingEvent",
      "type": "object"
    },
    "FindingKind": {
      "enum": [
        "cache_prefix",
        "duplicate_tool_call",
        "context_bloat",
        "oversized_model",
        "doomed_retry"
      ],
      "title": "FindingKind",
      "type": "string"
    },
    "FindingStatus": {
      "enum": [
        "proposed",
        "selected",
        "applied",
        "reverted",
        "skipped"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "JobDoneEvent": {
      "additionalProperties": false,
      "properties": {
        "seq": {
          "description": "Starts at 1 and rises by 1 per job; also the SSE id",
          "title": "Seq",
