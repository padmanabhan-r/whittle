        "cache_write_tokens": {
          "title": "Cache Write Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "title": "Cost Usd",
          "type": "number"
        },
        "running_cost_usd": {
          "description": "Total for this phase so far; drives the meter",
          "title": "Running Cost Usd",
          "type": "number"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        }
      },
      "required": [
        "seq",
        "ts",
        "job_id",
        "phase",
        "task_id",
        "call_index",
        "model",
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "cost_usd",
        "running_cost_usd",
        "duration_ms"
