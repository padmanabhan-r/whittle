      "required": [
        "seq",
        "ts",
        "job_id",
        "outcome",
        "summary"
      ],
      "title": "JobDoneEvent",
      "type": "object"
    },
    "JobErrorEvent": {
      "additionalProperties": false,
      "properties": {
        "seq": {
          "description": "Starts at 1 and rises by 1 per job; also the SSE id",
          "title": "Seq",
