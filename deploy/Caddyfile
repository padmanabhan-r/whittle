# Whittle behind one hostname with HTTPS. Caddy fetches and renews the certificate itself.
# The API and UI share one origin, so the web build uses VITE_API_URL="" and calls /api here.
#
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy

www.whittleai.site {
    redir https://whittleai.site{uri} permanent
}

whittleai.site {
    encode zstd gzip

    # The API, its event stream and the recording proxy, all on the backend port.
    reverse_proxy /api/*   localhost:8787 {
        flush_interval -1       # server-sent events must not be buffered
    }
    reverse_proxy /proxy/* localhost:8787
    reverse_proxy /health  localhost:8787

    # The deploy workflow copies the production UI build here.
    root * /var/www/whittle
    try_files {path} /index.html
    file_server
}
