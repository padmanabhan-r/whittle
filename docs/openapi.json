  "components": {
    "schemas": {
      "CallRef": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "call_index": {
            "type": "integer",
            "title": "Call Index"
          },
          "effect": {
            "type": "string",
            "enum": [
              "removed",
              "reduced"
            ],
            "title": "Effect",
            "description": "removed: the fix drops this call; reduced: the call stays and costs less"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "task_id",
          "call_index",
          "effect"
        ],
        "title": "CallRef",
        "description": "A baseline call a finding points at."
      },
      "CodeLocation": {
        "properties": {
          "file": {
            "type": "string",
            "title": "File"
          },
          "line_start": {
            "type": "integer",
            "title": "Line Start"
          },
          "line_end": {
            "type": "integer",
            "title": "Line End"
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Symbol"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "file",
          "line_start",
          "line_end"
        ],
        "title": "CodeLocation"
      },
      "Comparison": {
        "properties": {
          "baseline": {
            "$ref": "#/components/schemas/RunTotals"
          },
          "after": {
            "$ref": "#/components/schemas/RunTotals"
          },
          "saving_pct": {
            "type": "number",
            "title": "Saving Pct"
          },
          "saving_usd_per_run": {
            "type": "number",
            "title": "Saving Usd Per Run"
          },
          "quality": {
            "$ref": "#/components/schemas/Quality"
          },
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/TaskComparison"
            },
            "type": "array",
            "title": "Tasks"
          },
          "by_finding": {
            "items": {
              "$ref": "#/components/schemas/FindingResult"
            },
            "type": "array",
            "title": "By Finding"
          },
          "projection": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Projection"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "baseline",
          "after",
          "saving_pct",
          "saving_usd_per_run",
          "quality",
          "tasks",
          "by_finding"
        ],
        "title": "Comparison"
      },
      "Diff": {
        "properties": {
          "base_commit": {
            "type": "string",
            "title": "Base Commit"
          },
          "branch": {
            "type": "string",
            "title": "Branch"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/FileDiff"
            },
            "type": "array",
            "title": "Files"
          },
          "unified": {
            "type": "string",
            "title": "Unified"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "base_commit",
          "branch",
          "files",
          "unified"
        ],
        "title": "Diff"
      },
      "ErrorBody": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/JobError"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorBody"
      },
      "Evidence": {
        "properties": {
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "span_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Span Id"
          },
          "trace_url": {
            "type": "string",
            "title": "Trace Url"
          },
          "note": {
            "type": "string",
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "trace_id",
          "trace_url",
          "note"
        ],
        "title": "Evidence"
      },
      "FileDiff": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "additions": {
            "type": "integer",
            "title": "Additions"
          },
          "deletions": {
            "type": "integer",
            "title": "Deletions"
          },
          "patch": {
            "type": "string",
            "title": "Patch"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "additions",
          "deletions",
          "patch"
        ],
        "title": "FileDiff"
      },
      "Finding": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "$ref": "#/components/schemas/FindingKind"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "estimated_saving_usd_per_run": {
            "type": "number",
            "title": "Estimated Saving Usd Per Run"
          },
          "estimated_saving_pct": {
            "type": "number",
            "title": "Estimated Saving Pct",
            "description": "Share of baseline cost per run, 0 to 100"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "calls": {
            "items": {
              "$ref": "#/components/schemas/CallRef"
            },
            "type": "array",
            "title": "Calls",
            "description": "Baseline calls where this waste shows"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CodeLocation"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/FindingStatus",
            "default": "proposed"
          },
          "status_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "summary",
          "severity",
          "estimated_saving_usd_per_run",
          "estimated_saving_pct",
          "evidence"
        ],
        "title": "Finding"
      },
      "FindingKind": {
        "type": "string",
        "enum": [
          "cache_prefix",
          "duplicate_tool_call",
          "context_bloat",
          "oversized_model",
          "doomed_retry"
        ],
        "title": "FindingKind"
      },
      "FindingList": {
        "properties": {
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Findings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "findings"
        ],
        "title": "FindingList"
      },
      "FindingResult": {
        "properties": {
          "finding_id": {
            "type": "string",
            "title": "Finding Id"
          },
          "status": {
            "$ref": "#/components/schemas/FindingStatus"
          },
          "saving_usd_per_run": {
            "type": "number",
            "title": "Saving Usd Per Run"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "finding_id",
          "status",
          "saving_usd_per_run"
        ],
        "title": "FindingResult"
      },
      "FindingStatus": {
        "type": "string",
        "enum": [
          "proposed",
          "selected",
          "applied",
          "reverted",
          "skipped"
        ],
        "title": "FindingStatus"
      },
      "FixRequest": {
        "properties": {
          "finding_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Finding Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "finding_ids"
        ],
        "title": "FixRequest"
      },
      "GithubSource": {
        "properties": {
          "type": {
            "type": "string",
            "const": "github",
            "title": "Type"
          },
          "repo_url": {
            "type": "string",
            "title": "Repo Url"
          },
          "ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ref",
            "description": "Branch, tag or commit; default branch if omitted"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "repo_url"
        ],
        "title": "GithubSource"
      },
      "Job": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "state": {
            "$ref": "#/components/schemas/JobState"
          },
          "source": {
