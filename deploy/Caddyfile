# Whittle behind one hostname with HTTPS. Caddy fetches and renews the certificate itself.
# The API and UI share one origin, so the web build uses VITE_API_URL="" and calls /api here.
#
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy

www.whittleai.site {
	redir https://whittleai.site{uri} permanent
}

whittleai.site {
	encode zstd gzip

	handle /api/* {
		reverse_proxy localhost:8787 {
			flush_interval -1
		}
	}

	handle /proxy/* {
		reverse_proxy localhost:8787
	}

	handle /health {
		rewrite * /proxy/health
		reverse_proxy localhost:8787
	}

	handle {
		root * /var/www/whittle
		try_files {path} /index.html
		file_server
	}
}
