        },
        "ts": {
          "title": "Ts",
          "type": "string"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "type": {
          "const": "job.error",
          "default": "job.error",
          "title": "Type",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "ts",
        "job_id",
        "code",
        "message"
      ],
      "title": "JobErrorEvent",
      "type": "object"
    },
    "JobState": {
      "enum": [
        "queued",
        "cloning",
        "installing",
        "baseline",
        "diagnosing",
        "awaiting_selection",
        "fixing",
        "verifying",
        "reporting",
        "done",
        "failed"
      ],
      "title": "JobState",
      "type": "string"
    },
    "JobStateEvent": {
      "additionalProperties": false,
      "properties": {
        "seq": {
          "description": "Starts at 1 and rises by 1 per job; also the SSE id",
          "title": "Seq",
          "type": "integer"
        },
        "ts": {
          "title": "Ts",
          "type": "string"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "type": {
          "const": "job.state",
          "default": "job.state",
          "title": "Type",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/JobState"
        },
        "previous": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobState"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "seq",
        "ts",
        "job_id",
        "state",
        "previous"
      ],
      "title": "JobStateEvent",
      "type": "object"
    },
    "JobSummary": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunTotals"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunTotals"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "saving_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Saving Pct"
        },
        "findings_total": {
          "default": 0,
          "title": "Findings Total",
          "type": "integer"
        },
        "findings_applied": {
          "default": 0,
          "title": "Findings Applied",
          "type": "integer"
        }
      },
      "title": "JobSummary",
      "type": "object"
    },
    "LlmCallEvent": {
      "additionalProperties": false,
      "description": "One model call made by the user's agent, as seen by the proxy.",
      "properties": {
        "seq": {
          "description": "Starts at 1 and rises by 1 per job; also the SSE id",
