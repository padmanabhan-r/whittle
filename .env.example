# Copy to .env.local and fill in. Never commit real values.

# neatlogs — https://app.neatlogs.com
NEATLOGS_API_KEY=
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com
NEATLOGS_WORKFLOW_NAME=my-agent

# Anthropic: every model call the agent makes
ANTHROPIC_API_KEY=

# cfo.ai — https://cfo.ai/neathacks (team lead signup; OAuth via MCP, no static API key)
# Connect https://api.cfo.ai/mcp in Cursor/Claude Code and authenticate in the browser.

# neatlogs Public API (S1/S5) — service account from org admin; not the ingest key
# NEATLOGS_TOKEN=
# NEATLOGS_PROJECT_ID=
# NEATLOGS_S5_TRACE_ID=   # optional: trace id for evaluator spike

# Optional partner credits
# CRUSTDATA_API_KEY=
# AWS_REGION=
